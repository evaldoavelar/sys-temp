# ~/.config/sys-temp/alert.env
# Configurações do Daemon de Alerta Térmico e Watchdog do sys-temp

# 1. Configurações do Telegram
# Crie um bot dedicado no Telegram através do @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ativar escuta interativa de comandos no Telegram (/status, /cancelar_kill, /matar_agora, /ajuda)
ENABLE_TELEGRAM_POLLING=true

# 2. Limiares Térmicos e Temporizadores
TEMP_THRESHOLD=85.0          # Temperatura em °C para disparar o alarme (padrão: 85°C)
ALERT_DELAY_SECONDS=120      # Segundos contínuos acima do limiar para enviar o alerta inicial (padrão: 120s = 2 min)
KILL_DELAY_SECONDS=300       # Segundos após o alerta para encerrar o processo ofensor se persistir (padrão: 300s = 5 min)
RECOVERY_THRESHOLD=75.0      # Temperatura em °C para considerar normalizado e enviar confirmação

# 3. Lista de Proteção de Processos (Whitelist)
# Processos que NUNCA serão finalizados pelo daemon (separados por vírgula)
PROTECTED_PROCESSES=systemd,init,sshd,gnome-shell,Xorg,wayland,pipewire,pulseaudio,dbus-daemon,hermes,bash,zsh,fish,tmux,screen,dockerd,containerd
